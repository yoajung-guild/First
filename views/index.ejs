<%- include('partials/header') %>

<div class="layout">
  <%- include('partials/nav') %>

  <main class="content">
    <section class="hero-card">
      <div class="hero-text">
        <h2>안녕하세요, <%= currentUser.nickname %>님! 🍨</h2>
        <p>오늘도 요아정 길드와 함께 즐거운 마비노기 되세요.</p>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-num"><%= memberCount %></span>
          <span class="hero-stat-label">길드원</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num"><%= attendance.monthlyCount %></span>
          <span class="hero-stat-label">이번달 출석</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num"><%= attendance.streak %></span>
          <span class="hero-stat-label">연속 출석</span>
        </div>
      </div>
    </section>

    <div class="grid-2">
      <!-- 공지사항 요약 -->
      <section class="panel">
        <div class="panel-head">
          <h3>📢 고정 공지</h3>
          <a href="/notice" class="panel-more">더보기</a>
        </div>
        <ul class="list-simple">
          <% pinnedNotices.forEach(n => { %>
            <li>
              <a href="/notice/<%= n.id %>">
                <span class="badge-pin">고정</span>
                <span class="list-title"><%= n.title %></span>
                <span class="list-date"><%= n.date %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </section>

      <!-- 출석 카드 -->
      <section class="panel">
        <div class="panel-head">
          <h3>📅 오늘의 출석</h3>
          <a href="/attendance" class="panel-more">더보기</a>
        </div>
        <div class="attendance-mini">
          <% if (attendance.todayChecked) { %>
            <p class="attendance-mini-msg done">오늘 출석 완료! 🎉</p>
          <% } else { %>
            <p class="attendance-mini-msg">아직 출석 전이에요.</p>
            <form action="/attendance/check" method="POST">
              <button type="submit" class="btn-primary btn-sm">출석체크 하기</button>
            </form>
          <% } %>
        </div>
      </section>
    </div>

    <div class="grid-2">
      <!-- 꿀팁 최신글 -->
      <section class="panel">
        <div class="panel-head">
          <h3>🍯 최신 꿀팁</h3>
          <a href="/tips" class="panel-more">더보기</a>
        </div>
        <ul class="list-simple">
          <% latestTips.forEach(t => { %>
            <li>
              <a href="/tips">
                <span class="badge-cat"><%= t.category %></span>
                <span class="list-title"><%= t.title %></span>
                <span class="list-date"><%= t.date %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </section>

      <!-- 사진첩 최신 -->
      <section class="panel">
        <div class="panel-head">
          <h3>📷 최신 사진</h3>
          <a href="/photos" class="panel-more">더보기</a>
        </div>
        <div class="photo-mini-grid">
          <% latestPhotos.forEach(p => { %>
            <div class="photo-mini">
              <div class="photo-mini-thumb" style="background-image:url('<%= p.imageUrl %>')"></div>
              <span class="photo-mini-title"><%= p.title %></span>
            </div>
          <% }) %>
        </div>
      </section>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
