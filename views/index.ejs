<%- include('partials/header') %>

<div class="layout">
  <%- include('partials/nav') %>

  <main class="content">
    <!-- 길드 소개 -->
    <section class="panel guild-intro">
      <h2 class="page-title"><%= guildIntro.title %></h2>
      <p class="guild-intro-desc"><%= guildIntro.description %></p>
    </section>

    <!-- 멤버 소개 -->
    <section class="panel">
      <div class="panel-head">
        <h3>👥 멤버 소개</h3>
        <a href="/members" class="panel-more">더보기</a>
      </div>
      <div class="member-mini-grid">
        <% members.slice(0, 4).forEach(m => { %>
          <a href="/members/<%= m.id %>" class="member-mini-card">
            <div class="member-mini-avatar" style="background-image:url('<%= m.avatar %>')"></div>
            <span class="member-mini-name"><%= m.nickname %></span>
            <span class="member-mini-intro"><%= m.intro %></span>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- 팁 & 공략 -->
    <section class="panel">
      <div class="panel-head">
        <h3>🍯 팁 &amp; 공략</h3>
        <a href="/tips" class="panel-more">더보기</a>
      </div>
      <div class="tip-thumb-row">
        <% tips.slice(0, 4).forEach(t => { %>
          <%- include('partials/tip_thumb', { t }) %>
        <% }) %>
      </div>
    </section>

    <!-- 나만의 스크린샷 -->
    <section class="panel">
      <div class="panel-head">
        <h3>📷 나만의 스크린샷</h3>
        <a href="/photos" class="panel-more">더보기</a>
      </div>
      <div class="photo-dashboard-grid">
        <% photos.slice(0, 4).forEach(p => { %>
          <%- include('partials/photo_thumb', { p }) %>
        <% }) %>
      </div>
    </section>
  </main>
</div>

<%- include('partials/footer') %>