<%- include('partials/header') %>

<div class="layout">
  <%- include('partials/nav') %>

  <main class="content">
    <!-- 길드 소개 -->
    <section class="panel guild-intro">
      <h2 class="page-title"><%= guildIntro.title %></h2>
      <p class="guild-intro-desc"><%= guildIntro.description %></p>
    </section>


<!-- 내 프로필 (로그인한 경우에만 표시) -->
<% if (currentUser) { %>
  <section class="panel my-profile-card">
    <div class="my-profile-avatar" style="background-image:url('<%= currentUser.avatar %>')"></div>
    <div class="my-profile-info">
      <div class="my-profile-name-row">
        <span class="my-profile-name"><%= currentUser.nickname %></span>
        <span class="my-profile-role role-badge-<%= currentUser.role %>"><%= currentUser.role %></span>
      </div>
      <span class="my-profile-attendance">이번 달 출석 <%= attendance.monthlyCount %>일</span>
    </div>

    <% if (attendance.todayChecked) { %>
      <span class="my-profile-checked">✅ 오늘 출석 완료</span>
    <% } else { %>
      <!-- TODO(API 연동): POST /api/attendance 로 교체 -->
      <form action="/attendance/check" method="POST">
        <button type="submit" class="btn-primary btn-sm">출석하기</button>
      </form>
    <% } %>
  </section>
<% } %>

    <!-- 멤버 소개 -->
    <section class="panel">
      <div class="panel-head">
        <h3>👥 멤버 소개</h3>
        <a href="/members" class="panel-more">더보기</a>
      </div>
      <div class="member-mini-grid">
        <% members.slice(0, 4).forEach(m => { %>
          <a href="/members/<%= m.id %>" class="member-mini-card">
            <div class="member-mini-avatar" style="background-image:url('<%= m.avatar %>')"></div>
            <span class="member-mini-name"><%= m.nickname %></span>
            <span class="member-mini-intro"><%= m.intro %></span>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- 팁 & 공략 -->
    <section class="panel">
      <div class="panel-head">
        <h3>🍯 팁 &amp; 공략</h3>
        <a href="/tips" class="panel-more">더보기</a>
      </div>
      <div class="tip-thumb-row">
        <% tips.slice(0, 4).forEach(t => { %>
          <%- include('partials/tip_thumb', { t }) %>
        <% }) %>
      </div>
    </section>

    <!-- 나만의 스크린샷 -->
    <section class="panel">
      <div class="panel-head">
        <h3>📷 나만의 스크린샷</h3>
        <a href="/photos" class="panel-more">더보기</a>
      </div>
      <div class="photo-dashboard-grid">
        <% photos.slice(0, 4).forEach(p => { %>
          <%- include('partials/photo_thumb', { p }) %>
        <% }) %>
      </div>
    </section>
  </main>
</div>

<%- include('partials/footer') %>