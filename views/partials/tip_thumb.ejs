<div
  class="tip-card-mini"
  onclick="openTipDetail(this)"
  data-id="<%= t.id %>"
  data-title="<%= t.title %>"
  data-category="<%= t.category %>"
  data-content="<%= t.content %>"
  data-author="<%= t.author %>"
  data-date="<%= t.date %>"
>
  <span class="badge-cat"><%= t.category %></span>
  <h4 class="tip-card-mini-title"><%= t.title %></h4>
  <p class="tip-card-mini-excerpt"><%= t.content %></p>
  <span class="tip-card-mini-meta"><%= t.author %> · <%= t.date %></span>
</div>